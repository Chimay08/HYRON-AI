# Copy to backend/.env (or .env at the project root). Never commit real values.

# --- GitHub (optional) -------------------------------------------------------
# Public repositories work without a token (GitHub allows 60 API requests/hour per IP).
# For private repositories, create a fine-grained token with read-only "Contents"
# (and "Metadata") permission for the repositories you are authorized to scan.
GITHUB_TOKEN=

# --- AI Security Copilot (optional) ------------------------------------------
# Without a key, deterministic template explanations are used.
ANTHROPIC_API_KEY=
# HYRON_AI_MODEL=claude-opus-5-5
# HYRON_AI_ENABLED=1
# Send dependency metadata from PRIVATE repositories to the AI service? (default: no)
# HYRON_AI_ALLOW_PRIVATE_DATA=0

# --- Server ------------------------------------------------------------------
# HYRON_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Scan / inspection requests allowed per client within the window (seconds)
# HYRON_SCAN_RATE_LIMIT=30
# HYRON_SCAN_RATE_WINDOW=600
# AI Copilot calls allowed per client within the window (only counted when an API key is set)
# HYRON_AI_RATE_LIMIT=20
# HYRON_AI_RATE_WINDOW=600
